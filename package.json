{
  "name": "pupuseria-sistema-ventas",
  "version": "1.0.0",
  "description": "Sistema de ventas para Pupusería Salvadoreña",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build-win": "electron-builder --win",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": [
    "ventas",
    "pupuseria",
    "reportes"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.6",
    "chart.js": "^4.4.0",
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "pdfkit": "^0.13.0"
  },
  "build": {
    "appId": "com.pupuseria.ventas",
    "productName": "Sistema de Ventas - Pupusería",
    "asar": true,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}